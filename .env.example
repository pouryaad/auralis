# Alle Variablen sind optional. TED und der Bekanntmachungsservice brauchen KEINEN Schlüssel.
# Kontakt im User-Agent (empfohlen, damit Betreiber dich bei Problemen erreichen):
CONTACT_EMAIL=
# TED
TED_COUNTRIES=DEU,AUT
TED_DAYS=120
TED_PAGE_SIZE=100
TED_MAX_PAGES=80
TED_DELAY_MS=600
TED_EXTRA_QUERY=
# Bekanntmachungsservice (oeffentlichevergabe.de)
OEV_DAYS=45
OEV_DELAY_MS=1500
# 1 = auch EU-weite Bekanntmachungen von dort übernehmen (sonst über TED, ohne Doppelungen)
OEV_INCLUDE_EU=
# Optional: Link-Vorlage zur Detailseite im Bekanntmachungsservice, Platzhalter {id} = Notice-ID (nur setzen, wenn geprüft)
OEV_NOTICE_URL_TEMPLATE=
# Schlüssel kommerzieller Anbieter (Name frei wählbar, in sources.json als ${NAME} referenzieren)
COMMERCIAL_API_KEY=
# Server
INTERVAL_MINUTES=60
PORT=8080
